import paqueteria.*

describe "Mensajeros de Pelicula" {
  test "PruebaPaquete1" {
    //preguntarle el precio 
    //al paquete, que contestará 
    //500 o 150 según el destino 
    //a donde se envía
    const paquete = new Paquete()

    paquete.pagado(true)
    paquete.destino(brooklyn)
    
    assert.equals(150, paquete.precioDestino())
  }

  test "PruebaPaquete2" {
    //al inicio el paquete no está 
    //pago, luego de que se marca 
    //como pago ya sí lo está.
    const paquete = new Paquete()
    paquete.pagado(false)
    
    assert.equals(false, paquete.pagado())
    paquete.pagar(50)
    assert.equals(true, paquete.pagado())
  }

  test "PruebaMensajeria1" {
    //El paquete de George que 
    //no está pago no puede ser 
    //llevado por Neo a la matrix.
    const paquete = new Paquete()
    paquete.destino(matrix)

    assert.equals(false, paquete.puedeSerEntregadoPor_(neo))
  }

  test "PruebaMensajeria2" {
    //El paquete de George 
    //que sí está pago puede ser 
    //llevado por Jean a la matrix
    const paquete = new Paquete()
    
    paquete.pagado(true)
    paquete.destino(matrix)
    
    assert.equals(true, paquete.puedeSerEntregadoPor_(jeanGray))
  }


  test "PruebaMensajeria3" {
    //El paquete de George que 
    //sí está pago no puede ser 
    //llevado por Sara (que pesa 70kg
    //a Brooklyn si es que utiliza un 
    //camión con un acoplado.
    const paquete = new Paquete()    

    paquete.pagado(true)
    paquete.destino(brooklyn)
    saraConnor.vehiculo(camion)
    saraConnor.pesoActualDeSara(70)
    camion.acoprados(1)
    
    assert.equals(false, paquete.puedeSerEntregadoPor_(saraConnor))
  }

  test "PruebaMensajeria4" {
    //La entrega anterior puede
    //hacerse si Sara usa una moto
    const paquete = new Paquete()  

    paquete.pagado(true)
    paquete.destino(brooklyn)
    saraConnor.vehiculo(moto)
    saraConnor.pesoActualDeSara(70)
    
    assert.equals(true, paquete.puedeSerEntregadoPor_(saraConnor))
  }


}

describe "Mensajeros De Peliculas2: Electric Boogalo" {
  test "pruebaEmpresa1" {
    //Contratar a Neo a la empresa, corroborar que
    //Neo forme parte de la empresa
    empresa.contratarMensajero(neo)

    assert.that(empresa.tieneEmpleado(neo))
  }

  test "pruebaEmpresa2" {
    //Despide a Neo a la empresa, corroborar que
    //Neo ya no forme parte de la empresa
    empresa.contratarMensajero(neo)
    empresa.despedirMensajero(neo)

    assert.notThat(empresa.tieneEmpleado(neo))
  }

  test "pruebaEmpresa3" {
    //Hubo un recorte de personal en la empresa, 
    //corroborar que TODOS los mensajeros fueron despedidos
    empresa.mensajeros([neo, saraConnor])
    empresa.despedirTodosLosMensajeros()

    assert.notThat(empresa.empresaGrande())
  }

  test "pruebaEmpresa4" {
    //Aparte de Neo se contrato a Sara Connor por
    //tener transporte. Averiguar si la empresa puede
    //ser considerada grande a este punto.

    empresa.contratarMensajero(neo)
    empresa.contratarMensajero(saraConnor)
    empresa.contratarMensajero(jeanGray)

    assert.that(empresa.empresaGrande())
  }

  test "pruebaEmpresa5" {
    //Llego un nuevo paquete a la empresa que debe ser
    //entregado en la brevedad a la matrix.
    //Averigua si Neo puede entregarlo a tiempo.
    const paquete = new Paquete()

    paquete.pagado(true)
    empresa.mensajeros([neo, saraConnor])

    assert.that(empresa.primerMensajeroDisponible(matrix))
  }

  test "pruebaEmpresa6" {
    //Estamos haciendo un control sobre el peso del
    //anterior paquete para medir mejor nuestros transportes
    //a Brookyln. Averiguar el peso de nuestro ultimo
    //mensajero, en este caso Sara con su moto que
    //deberia devolver 100.

    empresa.mensajeros([neo, saraConnor])

    assert.equals(100, empresa.pesoDelUltimoMensajero())
  }
}

describe "Mensajeria Recargada (3)" {
  test "pruebaEntrega1" {
    //Averiguar si un paquete cualquiera puede ser
    //entregado por la empresa. Es decir, si al menos
    //1 mensajero puede entregarla.
    const paquete = new Paquete()

    paquete.pagar(50)
    paquete.destino(matrix)
    neo.credito(false)
    empresa.contratarMensajero(neo)
    empresa.contratarMensajero(saraConnor)
    empresa.contratarMensajero(jeanGray)

    assert.that(empresa.elPrimeroQuePuedaEntregar(paquete))
  }

  test "pruebaEntrega2" {
    //La empresa busca averiguar que mensajeros
    //pueden entregar un paquete. Averiguando quienes pueden
    //enviarlo a la matrix.
    const paquete = new Paquete()

    paquete.pagar(50)
    paquete.destino(matrix)
    neo.credito(true)
    empresa.contratarMensajero(neo)
    empresa.contratarMensajero(saraConnor)
    empresa.contratarMensajero(jeanGray)

    assert.equals([neo, jeanGray], empresa.losQuePuedenEnviar(paquete))
  }

  test "pruebaPeso"{
    //Averiguar si la empresa tiene un problema de sobrepeso
    //superando los 500kg en el promedio de sus empleados.
    //Para esto, Sara Connor trajo su camion.

    saraConnor.vehiculo(camion)
    camion.acoprados(3)
    empresa.contratarMensajero(neo)
    empresa.contratarMensajero(saraConnor)
    empresa.contratarMensajero(jeanGray)

    assert.that(empresa.sobrepesoMensajeria())
  }

  test "Envio1"{
    //Averiguar si la empresa puede enviar un paquete
    //de manera efectiva. Viendo si hay algun miembro
    //de los mensajeros capacitado o sino enviandolo a
    //pendientes.
    const paquete = new Paquete()


    paquete.pagar(50)
    paquete.destino(brooklyn)
    neo.credito(false)
    empresa.contratarMensajero(neo)
    empresa.contratarMensajero(saraConnor)
    
    empresa.enviar(paquete)

    assert.equals(0, empresa.cantidadPaquetesPendientes())

    paquete.destino(matrix)
    empresa.enviar(paquete)

    assert.equals(1, empresa.cantidadPaquetesPendientes())
  }

  test "facturacion"{
    //Queremos averiguar la facturacion de la empresa
    //tras una serie vario pinta de pedidos que involucran
    //2 paquetes, un paquetito y 1 paquete viajero a 2 destinos

    const paquete1 = new Paquete()
    const paquete2 = new Paquete()
    const paquetito1 = new Paquetito()
    const paquetote = new PaquetonViajero(destinos = [brooklyn, matrix])

    paquete1.pagar(50)
    paquete1.destino(matrix)
    paquete2.destino(brooklyn)
    paquetito1.destino(brooklyn)
    empresa.contratarMensajero(neo)
    empresa.contratarMensajero(saraConnor)
    saraConnor.vehiculo(moto)
    empresa.contratarMensajero(jeanGray) 

    empresa.enviar(paquete1)

    paquete2.pagar(50)

    empresa.enviar(paquete2)

    assert.equals(100, empresa.facturacionActual())

    empresa.enviar(paquetito1)
    paquetote.pagar(200)
    empresa.enviar(paquetote)

    assert.equals(300, empresa.facturacionActual())
  }

  test "envioMasivo"{
    //La empresa recibio un total de 5 paquetes, 2 paquetitos y 1 viajero
    //Tenemos que enviarlos a todos PRONTO
    const paquete1 = new Paquete(destino = matrix)
    const paquete2 = new Paquete(destino = brooklyn)
    const paquetito1 = new Paquetito(destino = brooklyn)
    const paquetito2 = new Paquetito(destino = matrix)
    const paqueton = new PaquetonViajero(destinos = [brooklyn, matrix])

    empresa.contratarMensajero(neo)
    empresa.contratarMensajero(saraConnor)
    saraConnor.vehiculo(camion)
    camion.acoprados(1)
    empresa.contratarMensajero(jeanGray)
    paquete1.pagar(50)
    paquete2.pagar(50)
    paqueton.pagar(200)

    empresa.enviarTodos([paquete1, paquete2, paquetito1, paquetito2, paqueton])

    assert.equals(5, empresa.cantidadPaquetesEnviados())
  }

  test "envioPremium"{
    //La empresa recibio una lista de 3 paquetes, uno de ellos 1 viajero
    //Este ultimo es extraorbitantemente caro y debido a esto y al los tiempos
    //de viaje debe ser llevado a su destino final cuanto antes
    const paquete1 = new Paquete(destino = matrix)
    const paquete2 = new Paquete(destino = brooklyn)
    const paqueton = new PaquetonViajero(destinos = [brooklyn, matrix, brooklyn, brooklyn])

    empresa.contratarMensajero(neo)
    empresa.contratarMensajero(saraConnor)
    saraConnor.vehiculo(camion)
    camion.acoprados(1)
    empresa.contratarMensajero(jeanGray)

    empresa.enviarTodos([paquete1, paquete2, paqueton])

    paquete1.pagar(50)
    paquete2.pagar(50)
    paqueton.pagar(400)

    empresa.enviarMasCaro()

    assert.equals(2, empresa.paquetesPendientes().size())

    assert.that(empresa.paquetesPendientes().contains(paquete1))
    assert.that(empresa.paquetesPendientes().contains(paquete2))
  }

  test "envioDelicado" {
    //Hemos recibido un pedido muy delicado y la empresa quiere asegurarse que
    //Al menos uno de sus mensajeros es capaz de transportarlo
    //De manera segura a su destino sin romperlo

    const paquete = new PaqueteFragil(destino = brooklyn)

    empresa.contratarMensajero(neo)
    empresa.contratarMensajero(saraConnor)
    saraConnor.vehiculo(camion)
    camion.acoprados(1)
    empresa.contratarMensajero(jeanGray)

    paquete.pagar(75)

    assert.that(empresa.hayAlgunMensajeroQuePuedeEntregar(paquete))
  }
  
  test "nuevoEmpleado" {
    //La mensajera Sara Connor fue atacada por un androide T-900 durante un envio
    //Logro neutralizarlo y al encontrarse en (relativas) buenas condiciones
    //La compañia decidio reprogramarlo y utilizarlo para realizar envios
    //al ser una maquina tiene conexion con la red, pudiendo entrar en la matrix cuando quiera
    //y es incansable pudiendo ir el solo  a pie hasta con paquetes pesados
    //En cambio tememos que por su peso (y falta de cuidado en general)
    //puede presentar problemas en la entrega de paquetes fragiles
    //asi que buscamos confirmar que funcione para paquetes comunes
    //y si tiene problemas con un paquete fragil

    const paqueteComun = new Paquete(destino = brooklyn)
    const paqueteDigital = new Paquete(destino = matrix)
    const paqueteDelicado = new PaqueteFragil(destino = brooklyn)
    empresa.contratarMensajero(t900)

    paqueteComun.pagar(50)
    paqueteDigital.pagar(50)
    paqueteDelicado.pagar(75)

    assert.that(paqueteComun.puedeSerEntregadoPor_(t900))
    assert.that(paqueteDigital.puedeSerEntregadoPor_(t900))
    assert.that(paqueteDelicado.puedeSerEntregadoPor_(t900))
  }
}