import paqueteria.*

describe "Mensajeros de Pelicula" {
  test "PruebaPaquete1" {
    //preguntarle el precio 
    //al paquete, que contestará 
    //500 o 150 según el destino 
    //a donde se envía
    paquete.pagado(true)
    
    assert.equals(150, paquete.precioDestino(brooklyn))
  }

  test "PruebaPaquete2" {
    //al inicio el paquete no está 
    //pago, luego de que se marca 
    //como pago ya sí lo está.
    paquete.pagado(false)
    
    assert.equals(false, paquete.pagado())
    paquete.pagar()
    assert.equals(true, paquete.pagado())
  }

  test "PruebaMensajeria1" {
    //El paquete de George que 
    //no está pago no puede ser 
    //llevado por Neo a la matrix.
    
    assert.equals(false, paquete.puedeSerEntregadoPor_En_(neo, matrix))
  }

  test "PruebaMensajeria2" {
    //El paquete de George 
    //que sí está pago puede ser 
    //llevado por Jean a la matrix
    paquete.pagado(true)
    
    assert.equals(true, paquete.puedeSerEntregadoPor_En_(jeanGray,matrix))
  }


  test "PruebaMensajeria3" {
    //El paquete de George que 
    //sí está pago no puede ser 
    //llevado por Sara (que pesa 70kg
    //a Brooklyn si es que utiliza un 
    //camión con un acoplado.

    paquete.pagado(true)
    saraConnor.vehiculo(camion)
    saraConnor.pesoActualDeSara(70)
    camion.acoprados(1)
    
    assert.equals(false, paquete.puedeSerEntregadoPor_En_(saraConnor, brooklyn))
  }

  test "PruebaMensajeria4" {
    //La entrega anterior puede
    //hacerse si Sara usa una moto

    paquete.pagado(true)
    saraConnor.vehiculo(moto)
    saraConnor.pesoActualDeSara(70)
    
    assert.equals(true, paquete.puedeSerEntregadoPor_En_(saraConnor, brooklyn))
  }


}

